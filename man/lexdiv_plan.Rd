\name{lexdiv_plan}
\alias{lexdiv_spec}
\alias{lexdiv_grid}
\alias{lexdiv_plan}
\alias{lexdiv_methods}
\alias{lexdiv_presets}
\alias{print.lexdiv_spec}
\alias{print.lexdiv_grid}
\alias{print.lexdiv_plan}
\alias{print.lexdiv_profile_results}
\alias{print.lexdiv_profile_batch_results}
\title{Build Explicit Lexical-Diversity Method Plans}
\description{
Builds bounded, reproducible plans for computing multiple parameter settings of
the versioned lexical-diversity methods. Execute a plan by passing
\code{plan = plan} to \code{\link{lexdiv_metrics}},
\code{\link{lexdiv_metrics_batch}}, \code{\link{lexdiv_metrics_text}}, or
\code{\link{lexdiv_metrics_text_batch}}.
}
\usage{
lexdiv_spec(method_id, parameters = list(), request_id = NULL)

lexdiv_grid(
  method_id,
  parameter,
  values,
  request_id_prefix = NULL,
  max_values = 128L
)

lexdiv_plan(
  presets = "canonical",
  specs = list(),
  grids = list(),
  max_specs = 128L
)

lexdiv_methods(scope = c("core", "variants"))

lexdiv_presets()

\method{print}{lexdiv_spec}(x, ...)

\method{print}{lexdiv_grid}(x, ...)

\method{print}{lexdiv_plan}(x, ...)

\method{print}{lexdiv_profile_results}(x, ...)

\method{print}{lexdiv_profile_batch_results}(x, ...)
}
\arguments{
  \item{method_id}{One versioned method identifier or core \code{metric_id}
  shorthand (such as \code{"mtld"} or \code{"mattr"}) listed by
  \code{lexdiv_methods()}.}
  \item{parameters}{A plain named list of user-settable method parameters.
  Omitted values are materialized from the versioned defaults.}
  \item{request_id}{An optional plain ASCII identifier used to join one request
  to its profile result.}
  \item{parameter}{The one user-settable scalar parameter admitted by the
  selected current method.}
  \item{values}{A non-empty numeric vector whose elements become distinct
  method specifications after validation and normalization.}
  \item{request_id_prefix}{An optional ASCII prefix for the one-based request
  IDs generated by \code{lexdiv_grid()}.}
  \item{max_values}{A positive integer bound on values expanded eagerly by one
  grid call.}
  \item{presets}{A duplicate-free plain character vector selected from
  \code{lexdiv_presets()}. Use \code{character()} for a custom-only plan.}
  \item{specs}{One \code{lexdiv_spec}, or a plain list of such objects, appended
  after preset requests.}
  \item{grids}{One \code{lexdiv_grid}, or a plain list of such objects, appended
  after explicit specifications.}
  \item{max_specs}{A positive integer bound on the number of distinct normalized
  specifications in a plan.}
  \item{scope}{\code{"core"} (default) lists the methods accepted by
  \code{lexdiv_spec()} and \code{lexdiv_metrics()}. \code{"variants"} lists
  comparison methods accepted by \code{\link{lexdiv_variant_metrics}}.}
  \item{x}{A specification, grid, plan, or profile result object.}
  \item{...}{Additional arguments passed to \code{print.data.frame()}.}
}
\value{
\code{lexdiv_spec()} returns a normalized \code{lexdiv_spec};
\code{lexdiv_grid()} returns an ordered \code{lexdiv_grid} list of
specifications; \code{lexdiv_plan()} returns a deduplicated \code{lexdiv_plan}
with an MD5 fingerprint over normalized request identity and order.
\code{lexdiv_methods()} and \code{lexdiv_presets()} return metadata data frames.
All print methods return \code{x} invisibly.
}
\examples{
methods <- lexdiv_methods()
lexdiv_presets()

# Shorthand metric_id ("mattr") resolves to its canonical method_id.
mattr_25 <- lexdiv_spec(
  "mattr",
  parameters = list(window_length = 25),
  request_id = "mattr_25"
)
grid <- lexdiv_grid(
  "mattr",
  parameter = "window_length",
  values = c(50, 100),
  request_id_prefix = "mattr"
)
plan <- lexdiv_plan(presets = character(), specs = mattr_25, grids = grid)
print(plan)

tokens <- rep(c("a", "b", "a", "c", "d"), 25)
profile <- lexdiv_metrics(tokens, plan = plan)
profile[, c("request_id", "metric_id", "value", "status")]

variants <- lexdiv_methods(scope = "variants")
nrow(variants)
}
\seealso{\code{\link{lexdiv_metrics}}, \code{\link{lexdiv_screen_lengths}},
\code{\link{lexdiv_study_table}}}
\keyword{text}
