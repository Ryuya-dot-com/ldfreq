{
  "$schema": "reference-coverage-contract.schema.json",
  "contract_id": "ldfreq-reference-coverage",
  "contract_version": "0.1.0",
  "status": "normative",
  "public_api": true,
  "input_contract": {
    "documents": "plain-named-list-or-explicit-id-and-term-list-column",
    "reference": "one-plain-valid-utf8-character-vector",
    "term_unit": "one-complete-term-per-vector-element",
    "invalid_term_policy": "document-local-invalid-input-no-silent-deletion",
    "invalid_reference_policy": "all-document-rows-invalid-input",
    "raw_text_shortcut": false
  },
  "matching_contract": {
    "comparison": "exact-unicode-scalar-sequence",
    "reference_membership": "distinct-reference-type-set",
    "normalization": "none",
    "case_conversion": "none",
    "stemming_or_fuzzy_matching": false,
    "document_token_repetition_affects_token_coverage": true,
    "document_token_repetition_affects_type_coverage": false,
    "reference_token_repetition_affects_values": false,
    "token_order_affects_values": false
  },
  "measures": [
    {
      "weighting": "token",
      "measure_id": "reference_coverage_tokens",
      "method_id": "document_tokens_in_reference_type_set_v1",
      "formula": "matched_document_tokens / document_tokens"
    },
    {
      "weighting": "type",
      "measure_id": "reference_coverage_types",
      "method_id": "document_types_in_reference_type_set_v1",
      "formula": "matched_document_types / document_types"
    }
  ],
  "empty_input_rules": {
    "empty_document": "both-measures-missing",
    "empty_reference_nonempty_document": "both-measures-zero",
    "empty_document_and_reference": "both-measures-missing",
    "empty_document_container": "typed-empty-summary-and-document-tables"
  },
  "result_contract": {
    "schema_id": "lexdiv-reference-coverage-result",
    "schema_version": "0.1.0",
    "components": [
      "summary", "documents", "reference", "terms", "preprocessing",
      "provenance"
    ],
    "summary_columns": [
      "document_id", "reference_id", "weighting", "measure_id", "method_id",
      "reference_coverage_contract_id", "reference_coverage_contract_version",
      "result_schema_id", "result_schema_version", "value", "status",
      "missing_reason", "numerator", "denominator", "document_tokens",
      "document_types", "reference_tokens", "reference_types",
      "matched_tokens", "matched_types", "analysis_scope", "unit"
    ],
    "document_columns": [
      "document_id", "state", "input_tokens", "input_types"
    ],
    "reference_columns": [
      "reference_id", "state", "input_tokens", "input_types"
    ],
    "term_columns": [
      "document_id", "reference_id", "term", "document_token_count",
      "reference_token_count", "matched"
    ],
    "summary_shape": "one-row-per-document-and-weighting",
    "numerator_and_denominator_columns": true,
    "document_and_reference_diagnostics": true,
    "default_term_details": "counts-only",
    "optional_term_details": "document-types-counts-reference-counts-and-match-indicators",
    "term_detail_disclosure": "provenance-flag-and-print-notice",
    "row_limit_scope": "all-returned-data-frame-rows"
  },
  "privacy_boundary": {
    "raw_text_copied_to_result": false,
    "text_hash_copied_to_result": false,
    "absolute_path_copied_to_result": false,
    "term_details_opt_in": true
  },
  "interpretation_boundary": {
    "direct_semantic_similarity_measure": false,
    "plagiarism_detector": false,
    "proficiency_or_writing_quality_measure": false,
    "reference_quality_measure": false
  }
}
