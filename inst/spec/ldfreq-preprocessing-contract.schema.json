{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ldfreq-preprocessing-contract.schema.json",
  "title": "ldfreq preprocessing contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "contract_id", "contract_version", "status", "public_api",
    "tokenizer", "normalization", "annotation", "lexical_units",
    "compatibility", "result_boundary"
  ],
  "properties": {
    "$schema": {"const": "ldfreq-preprocessing-contract.schema.json"},
    "contract_id": {"const": "ldfreq-preprocessing"},
    "contract_version": {"const": "0.1.0"},
    "status": {"const": "normative"},
    "public_api": {"const": true},
    "tokenizer": {"type": "object"},
    "normalization": {"type": "object"},
    "annotation": {"type": "object"},
    "lexical_units": {"type": "object"},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serialized_0_1_0_tokenization", "migration"],
      "properties": {
        "serialized_0_1_0_tokenization": {
          "const": "not-automatically-migrated"
        },
        "migration": {
          "const": "retokenize-original-text-and-reapply-current-annotations"
        }
      }
    },
    "result_boundary": {"type": "object"}
  }
}
