{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ldfreq installed resource manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "package_scope",
    "runtime_policy",
    "resources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "package_scope": {
      "const": "optional-reference-resources"
    },
    "runtime_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_access",
        "implicit_download_or_fallback",
        "explicit_download_api"
      ],
      "properties": {
        "network_access": {
          "const": false
        },
        "implicit_download_or_fallback": {
          "const": false
        },
        "explicit_download_api": {
          "const": "lexdiv_download_resources"
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "resource_id",
          "resource_name",
          "distribution",
          "download",
          "package_members"
        ],
        "properties": {
          "distribution": {
            "const": "explicit-download"
          },
          "download": {
            "type": "object",
            "required": [
              "url",
              "sha256",
              "bytes",
              "files"
            ]
          },
          "package_members": {
            "type": "array"
          }
        }
      }
    }
  }
}
