{
  "$schema": "norm-profile-batch-contract.schema.json",
  "contract_id": "ldfreq-generic-norm-profile-batch",
  "contract_version": "0.1.0",
  "status": "normative",
  "public_api": true,
  "function": "lexdiv_norm_profile_batch",
  "single_document_contract": {
    "file": "norm-profile-contract.json",
    "contract_version": "0.1.0",
    "arithmetic_and_matching_unchanged": true
  },
  "input_contract": {
    "containers": [
      "plain-named-list",
      "data-frame-with-id-and-terms-list-column"
    ],
    "default_id_column": "document_id",
    "default_terms_column": "terms",
    "unique_explicit_document_ids": true,
    "empty_documents_allowed": true,
    "zero_documents_allowed": true,
    "invalid_terms": "whole-call-error",
    "shared_resource_validation_count": 1,
    "extra_document_columns_copied": false,
    "normalization": "none",
    "runtime_network_access": false
  },
  "row_budget_contract": {
    "formula": "measures * sum(document_term_counts) + 2 * documents * measures * weightings",
    "scope": "lookup-plus-summary-plus-coverage",
    "default_max_rows": 1000000,
    "checked_before_lookup_and_result_allocation": true
  },
  "result_contract": {
    "schema_id": "generic-norm-profile-batch-result",
    "schema_version": "0.1.0",
    "class": "lexdiv_norm_profile_batch",
    "components": [
      "status",
      "summary",
      "lookup",
      "coverage",
      "provenance",
      "diagnostics"
    ],
    "lookup_columns": [
      "document_id",
      "input_index",
      "term",
      "measure_id",
      "lookup_status",
      "value",
      "value_status"
    ],
    "summary_columns": [
      "document_id",
      "result_order",
      "resource_id",
      "resource_version",
      "measure_id",
      "construct_id",
      "value_unit",
      "direction",
      "language",
      "variety",
      "population_id",
      "collection_year",
      "statistic_id",
      "weighting",
      "type_identity",
      "estimate",
      "status",
      "missing_reason",
      "input_units",
      "matched_units",
      "unmatched_units",
      "observed_value_units",
      "matched_missing_value_units",
      "resource_coverage",
      "value_coverage",
      "annotation_coverage"
    ],
    "coverage_columns": [
      "document_id",
      "result_order",
      "resource_id",
      "resource_version",
      "measure_id",
      "weighting",
      "input_units",
      "matched_units",
      "unmatched_units",
      "observed_value_units",
      "matched_missing_value_units",
      "resource_coverage",
      "value_coverage",
      "annotation_coverage"
    ],
    "lookup_order": "document-major-input-major-measure-minor",
    "summary_order": "document-major-measure-major-requested-weighting-order",
    "result_order": "restarts-per-document",
    "status_values": [
      "ok",
      "empty"
    ],
    "empty_status": "zero-documents-only",
    "single_provenance_preserved": true,
    "batch_provenance_fields": [
      "batch_contract_id",
      "batch_contract_version",
      "batch_result_schema_id",
      "batch_result_schema_version",
      "document_count",
      "document_ids"
    ],
    "document_diagnostic_columns": [
      "document_id",
      "status",
      "input_terms",
      "input_types",
      "planned_lookup_rows",
      "planned_summary_rows",
      "planned_coverage_rows",
      "planned_result_rows"
    ],
    "bounded_print_rows": 12,
    "plot_method": false,
    "summary_method": false,
    "as_data_frame_method": false
  },
  "interpretation_boundary": {
    "document_pooling": false,
    "composite_score": false,
    "automatic_coverage_threshold": false,
    "oov_imputation": false,
    "missing_value_imputation": false,
    "data_license_approval": false,
    "save_actual_resource_and_metadata_separately": true
  }
}
