{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tubelex-frequency-profile-contract.schema.json",
  "title": "ldfreq TUBELEX frequency profile contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "contract_id", "contract_version", "status", "public_api",
    "release_approved", "resource", "query_normalization", "lookup_columns",
    "summary", "runtime_policy", "remaining_release_gates"
  ],
  "properties": {
    "$schema": {"const": "tubelex-frequency-profile-contract.schema.json"},
    "contract_id": {"const": "ldfreq-tubelex-frequency-profile"},
    "contract_version": {"const": "0.1.0-draft.1"},
    "status": {"const": "public-api-release-candidate"},
    "public_api": {"const": true},
    "release_approved": {"const": true},
    "resource": {"type": "object"},
    "query_normalization": {"type": "object"},
    "lookup_columns": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "summary": {"type": "object"},
    "runtime_policy": {"type": "object"},
    "remaining_release_gates": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  }
}
