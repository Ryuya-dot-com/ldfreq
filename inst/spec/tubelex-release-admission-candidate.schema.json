{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ryuya-dot-com/ldfreq/raw/main/inst/spec/tubelex-release-admission-candidate.schema.json",
  "title": "ldfreq TUBELEX release-admission candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "candidate_id",
    "candidate_state",
    "resource",
    "distribution_scope",
    "contract_refs",
    "admission_policy",
    "maintainer_decision",
    "remaining_gates_after_resource_approval"
  ],
  "properties": {
    "$schema": {"const": "tubelex-release-admission-candidate.schema.json"},
    "schema_version": {"const": "0.3.0"},
    "candidate_id": {"const": "tubelex-en-treebank-slim-7cb5fb36-public-profile-admission-v3"},
    "candidate_state": {"const": "maintainer-approved"},
    "resource": {"$ref": "#/$defs/resource"},
    "distribution_scope": {"$ref": "#/$defs/distributionScope"},
    "contract_refs": {"$ref": "#/$defs/contractRefs"},
    "admission_policy": {"$ref": "#/$defs/admissionPolicy"},
    "maintainer_decision": {"$ref": "#/$defs/maintainerDecision"},
    "remaining_gates_after_resource_approval": {
      "type": "array",
      "prefixItems": [
        {"const": "final release-candidate source, installed, and binary inventory audit"}
      ],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "resource_version",
        "upstream_commit",
        "upstream_source_sha256",
        "manifest_sha256",
        "artifact_sha256",
        "content_sha256",
        "license_spdx",
        "notice_path",
        "notice_sha256"
      ],
      "properties": {
        "resource_id": {"const": "tubelex-en-treebank-slim"},
        "resource_version": {"const": "7cb5fb36-slim-v1"},
        "upstream_commit": {"const": "7cb5fb36add76b83a266d1967536e1a1d3faa513"},
        "upstream_source_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "license_spdx": {"const": "BSD-3-Clause"},
        "notice_path": {"const": "licenses/tubelex/NOTICE.md"},
        "notice_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "distributionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_component_state",
        "raw_source_bundled",
        "raw_subtitles_or_identifiers_included",
        "runtime_network_access",
        "implicit_download_or_fallback",
        "public_api",
        "release_approved"
      ],
      "properties": {
        "package_component_state": {"const": "release-candidate"},
        "raw_source_bundled": {"const": false},
        "raw_subtitles_or_identifiers_included": {"const": false},
        "runtime_network_access": {"const": false},
        "implicit_download_or_fallback": {"const": false},
        "public_api": {"const": true},
        "release_approved": {"const": true}
      }
    },
    "contractRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loader_contract_id",
        "loader_contract_version",
        "lookup_contract_id",
        "lookup_contract_version",
        "lookup_result_schema_id",
        "lookup_result_schema_version",
        "public_profile_contract_id",
        "public_profile_contract_version"
      ],
      "properties": {
        "loader_contract_id": {"const": "ldfreq-lexical-sophistication-profile"},
        "loader_contract_version": {"const": "0.1.0-draft.2"},
        "lookup_contract_id": {"const": "ldfreq-lexical-resource-lookup"},
        "lookup_contract_version": {"const": "0.1.0-draft.1"},
        "lookup_result_schema_id": {"const": "lexres-frequency-prevalence-result"},
        "lookup_result_schema_version": {"const": "0.1.0-draft.1"},
        "public_profile_contract_id": {"const": "ldfreq-tubelex-frequency-profile"},
        "public_profile_contract_version": {"const": "0.1.0-draft.1"}
      }
    },
    "admissionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_authority",
        "independent_reviewer_required",
        "optional_independent_review_permitted",
        "automated_identity_checks_required",
        "final_inventory_audit_required"
      ],
      "properties": {
        "decision_authority": {"const": "package-maintainer"},
        "independent_reviewer_required": {"const": false},
        "optional_independent_review_permitted": {"const": true},
        "automated_identity_checks_required": {"const": true},
        "final_inventory_audit_required": {"const": true}
      }
    },
    "maintainerDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "decision",
        "decided_on",
        "decided_by",
        "legal_basis",
        "approved_scopes",
        "risk_controls"
      ],
      "properties": {
        "decision_id": {"const": "tubelex-maintainer-redistribution-decision-2026-08-06"},
        "decision": {"const": "approved"},
        "decided_on": {"const": "2026-08-06"},
        "decided_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "github_login", "role"],
          "properties": {
            "name": {"const": "Komuro Ryuya"},
            "github_login": {"const": "Ryuya-dot-com"},
            "role": {"const": "package-maintainer"}
          }
        },
        "legal_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "upstream_repository",
            "pinned_license_url",
            "upstream_readme_url",
            "cran_policy_url",
            "license_spdx",
            "interpretation"
          ],
          "properties": {
            "upstream_repository": {"const": "https://github.com/naist-nlp/tubelex"},
            "pinned_license_url": {"type": "string", "format": "uri"},
            "upstream_readme_url": {"type": "string", "format": "uri"},
            "cran_policy_url": {"const": "https://cran.r-project.org/web/packages/policies.html"},
            "license_spdx": {"const": "BSD-3-Clause"},
            "interpretation": {"type": "string", "minLength": 1}
          }
        },
        "approved_scopes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "redistribution_terms",
            "notice_and_attribution",
            "source_and_artifact_identity",
            "package_distribution_scope",
            "public_api_scope"
          ],
          "properties": {
            "redistribution_terms": {"const": true},
            "notice_and_attribution": {"const": true},
            "source_and_artifact_identity": {"const": true},
            "package_distribution_scope": {"const": true},
            "public_api_scope": {"const": true}
          }
        },
        "risk_controls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_subtitles_or_identifiers_included",
            "upstream_commit_and_source_hash_pinned",
            "bsd_notice_and_disclaimer_installed",
            "transformation_disclosed",
            "runtime_download_or_fallback",
            "independent_legal_opinion_obtained"
          ],
          "properties": {
            "raw_subtitles_or_identifiers_included": {"const": false},
            "upstream_commit_and_source_hash_pinned": {"const": true},
            "bsd_notice_and_disclaimer_installed": {"const": true},
            "transformation_disclosed": {"const": true},
            "runtime_download_or_fallback": {"const": false},
            "independent_legal_opinion_obtained": {"const": false}
          }
        }
      }
    }
  }
}
