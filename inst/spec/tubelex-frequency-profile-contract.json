{
  "$schema": "tubelex-frequency-profile-contract.schema.json",
  "contract_id": "ldfreq-tubelex-frequency-profile",
  "contract_version": "0.2.0",
  "status": "normative",
  "public_api": true,
  "resource": {
    "resource_id": "tubelex-en-treebank-slim",
    "resource_version": "7cb5fb36-slim-v1",
    "lookup_unit": "surface-form",
    "corpus_interpretation": "general-youtube-subtitle-frequency-space",
    "not_claimed_constructs": [
      "language-proficiency",
      "writing-quality",
      "academic-register",
      "context-independent-lexical-sophistication",
      "learner-lexical-employability"
    ]
  },
  "query_normalization": {
    "choices": {
      "tubelex": "nfkc-trim-en-lower-v1",
      "tubelex_apostrophe": "nfkc-trim-en-lower-internal-apostrophe-v1",
      "identity": "identity-valid-utf8-v1"
    },
    "default": "tubelex",
    "apostrophe_transform": "after-default-normalization-map-U2019-and-U2032-before-a-letter-mark-or-number-and-after-a-letter-mark-or-number-or-at-term-start-to-U0027",
    "segmentation_performed": false,
    "original_and_lookup_terms_retained": true,
    "normalization_collisions_reported": true
  },
  "input_boundary": {
    "resource_segmentation": "penn-treebank",
    "tokenization_mismatch_choices": [
      "error",
      "allow"
    ],
    "tokenization_mismatch_default": "error",
    "lexdiv_tokenization_alignment": "known_different_tokenizer_explicitly_allowed",
    "character_terms_alignment": "caller_supplied_terms_unverified",
    "coverage_validates_segmentation": false
  },
  "batch": {
    "export": "tubelex_profile_batch",
    "result": "input-ordered-named-list-of-complete-tubelex_profile-objects",
    "resource_scope": "one-lazily-verified-snapshot-per-call-no-global-cache",
    "row_budget": "sum-of-planned-lookup-and-two-summary-rows-per-document-before-loading",
    "invalid_terms": "document-local-invalid-profile",
    "structural_errors_and_known_tokenizer_mismatches": "stop-before-loading"
  },
  "lookup_columns": [
    "query_index",
    "term",
    "lookup_term",
    "matched",
    "resource_word",
    "count",
    "videos",
    "channels",
    "zipf",
    "video_prevalence",
    "channel_prevalence"
  ],
  "result_status": {
    "statuses": [
      "ok",
      "empty",
      "invalid_input",
      "resource_error"
    ],
    "status_semantics": {
      "ok": "a non-empty valid input was looked up successfully",
      "empty": "a valid zero-term input produced typed zero-row output",
      "invalid_input": "the supplied terms failed input validation",
      "resource_error": "the bundled resource failed an integrity or availability check"
    }
  },
  "summary": {
    "weightings": [
      "token",
      "type"
    ],
    "matched_only": true,
    "unmatched_measurements": "missing-not-zero",
    "statistics": [
      "mean_zipf",
      "sd_zipf",
      "mean_video_prevalence",
      "mean_channel_prevalence"
    ],
    "coverage_adjacent": true
  },
  "runtime_policy": {
    "network_access": false,
    "download": false,
    "fallback": false,
    "byte_pinned_local_resource": true
  },
  "diagnostic_tables": {
    "export": "tubelex_diagnostics",
    "version": "0.1.0",
    "input": "unmodified-current-resource-profile-contract-0.2.0-single-or-plain-named-list",
    "components": [
      "summary",
      "documents",
      "unmatched_terms",
      "normalization_mappings",
      "provenance",
      "diagnostics"
    ],
    "status_policy": "retain-empty-invalid-and-resource-error-documents; unresolved-matches-not-counted-as-unmatched",
    "counts": "occurrences-and-distinct-document-IDs-within-recorded-input-condition",
    "condition_id": "call-local-first-seen-resource-query-input-and-tokenizer-setting-group; not-verified-alignment",
    "max_rows": "input-lookup-rows-plus-two-summary-rows-per-document-before-aggregation",
    "resource_lookup_repeated": false,
    "learner_ability_inferred": false,
    "metadata": "complete-provenance-and-diagnostics-per-document",
    "summary_columns": [
      "document_id",
      "condition_id",
      "status",
      "failure_reason",
      "weighting",
      "eligible_items",
      "matched_items",
      "coverage",
      "mean_zipf",
      "sd_zipf",
      "mean_video_prevalence",
      "mean_channel_prevalence"
    ],
    "unmatched_columns": [
      "condition_id",
      "lookup_term",
      "token_count",
      "document_count"
    ],
    "mapping_columns": [
      "condition_id",
      "term",
      "lookup_term",
      "matched",
      "token_count",
      "document_count",
      "lookup_changed",
      "number_marker"
    ]
  }
}
